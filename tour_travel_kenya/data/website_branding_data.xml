<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Browser-tab favicon, and separately website.logo/website.name (used
         by the mobile header), for the main website - not demo data, so
         they apply on every install regardless of whether demo data is
         loaded.

         Set through function calls rather than <record> on
         website.default_website: that xmlid is noupdate in the website
         module, so module upgrades skip any record that targets it.
         See Website._kt_apply_favicon / _kt_apply_logo. -->
    <function model="website" name="_kt_apply_favicon"/>
    <function model="website" name="_kt_apply_logo"/>
    <function model="website" name="_kt_apply_seo_page_meta"/>
</odoo>
