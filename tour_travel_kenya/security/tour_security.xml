<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="res.groups.privilege" id="res_groups_privilege_tours">
            <field name="name">Seriani Tours &amp; Travel</field>
            <field name="category_id" ref="base.module_category_marketing"/>
        </record>

        <record id="group_tour_user" model="res.groups">
            <field name="name">User: Manage Packages &amp; Bookings</field>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_tours"/>
        </record>

        <record id="group_tour_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_tour_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_tours"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record model="ir.rule" id="tour_package_company_rule">
            <field name="name">Tour Package: multi-company</field>
            <field name="model_id" ref="model_tour_package"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record model="ir.rule" id="tour_booking_company_rule">
            <field name="name">Tour Booking: multi-company</field>
            <field name="model_id" ref="model_tour_booking"/>
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>
        <record model="ir.rule" id="tour_booking_portal_rule">
            <field name="name">Tour Booking: portal users see only their own</field>
            <field name="model_id" ref="model_tour_booking"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>
    </data>
</odoo>
