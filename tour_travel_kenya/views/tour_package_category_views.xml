<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_package_category_list" model="ir.ui.view">
        <field name="name">tour.package.category.list</field>
        <field name="model">tour.package.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="package_count"/>
            </list>
        </field>
    </record>

    <record id="view_tour_package_category_form" model="ir.ui.view">
        <field name="name">tour.package.category.form</field>
        <field name="model">tour.package.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tour_package_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">tour.package.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_tour_package_tag_list" model="ir.ui.view">
        <field name="name">tour.package.tag.list</field>
        <field name="model">tour.package.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_tour_package_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">tour.package.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
