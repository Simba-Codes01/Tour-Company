<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_package_pricing_list" model="ir.ui.view">
        <field name="name">tour.package.pricing.list</field>
        <field name="model">tour.package.pricing</field>
        <field name="arch" type="xml">
            <list string="Pricing Tiers" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="package_id" column_invisible="context.get('default_package_id')"/>
                <field name="name"/>
                <field name="product_id" required="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="seats_max"/>
            </list>
        </field>
    </record>

    <record id="view_tour_package_pricing_form" model="ir.ui.view">
        <field name="name">tour.package.pricing.form</field>
        <field name="model">tour.package.pricing</field>
        <field name="arch" type="xml">
            <form string="Pricing Tier">
                <sheet>
                    <group>
                        <field name="package_id"/>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="currency_id" invisible="1"/>
                <field name="price" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="seats_max"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
