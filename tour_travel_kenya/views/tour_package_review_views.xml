<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tour_package_review_list" model="ir.ui.view">
        <field name="name">tour.package.review.list</field>
        <field name="model">tour.package.review</field>
        <field name="arch" type="xml">
            <list string="Reviews" decoration-muted="state == 'rejected'" decoration-info="state == 'pending'">
                <field name="create_date" string="Submitted" widget="date"/>
                <field name="package_id"/>
                <field name="author_name"/>
                <field name="rating" widget="priority" readonly="1"/>
                <field name="title"/>
                <field name="comment" optional="hide"/>
                <field name="is_verified" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="helpful_count" optional="show"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'published'"
                       decoration-danger="state == 'rejected'"/>
                <button name="action_publish" type="object" string="Publish" icon="fa-check"
                        class="text-success" invisible="state == 'published'"/>
                <button name="action_reject" type="object" string="Reject" icon="fa-times"
                        class="text-danger" invisible="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_tour_package_review_form" model="ir.ui.view">
        <field name="name">tour.package.review.form</field>
        <field name="model">tour.package.review</field>
        <field name="arch" type="xml">
            <form string="Review">
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state == 'published'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state == 'rejected'"/>
                    <button name="action_reset_pending" type="object" string="Back to Pending"
                            invisible="state == 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,published"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" invisible="not is_verified"/>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title" placeholder="e.g. Unforgettable week in the Mara"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="package_id"/>
                            <field name="rating" widget="priority"/>
                            <field name="travel_type"/>
                            <field name="booking_id"/>
                        </group>
                        <group>
                            <field name="author_name"/>
                            <field name="author_email" widget="email"/>
                            <field name="partner_id"/>
                            <field name="is_verified"/>
                            <field name="create_date" string="Submitted On" readonly="1"/>
                            <field name="published_date"/>
                            <field name="helpful_count"/>
                        </group>
                    </group>
                    <separator string="Review"/>
                    <field name="comment" nolabel="1"/>
                    <separator string="Our Response"/>
                    <field name="response" nolabel="1"
                           placeholder="Optional public reply, shown under the review on the website."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tour_package_review_search" model="ir.ui.view">
        <field name="name">tour.package.review.search</field>
        <field name="model">tour.package.review</field>
        <field name="arch" type="xml">
            <search string="Reviews">
                <field name="author_name"/>
                <field name="package_id"/>
                <field name="comment"/>
                <filter name="filter_pending" string="Pending Approval" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_verified" string="Verified Travelers" domain="[('is_verified', '=', True)]"/>
                <filter name="filter_low" string="3 Stars or Less" domain="[('rating', '&lt;=', 3)]"/>
                <group>
                    <filter name="group_package" string="Package" context="{'group_by': 'package_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_rating" string="Rating" context="{'group_by': 'rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tour_package_review" model="ir.actions.act_window">
        <field name="name">Reviews</field>
        <field name="res_model">tour.package.review</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reviews to moderate</p>
            <p>Reviews submitted on the website land here for approval before they go live.</p>
        </field>
    </record>
</odoo>
