<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- website_sale ships a minimal site-wide Organization JSON-LD block
         (name/logo/url only) in every page's head. Replace it with a proper
         TravelAgency listing - see Website._kt_get_organization_structured_data
         for the fields and why it's built in Python. -->
    <template id="kt_organization_structured_data" inherit_id="website_sale.website_sale_layout" name="Seriani Structured Data (Organization)">
        <xpath expr="//script[@t-if='res_company and website']" position="replace">
            <script t-if="res_company and website" type="application/ld+json" t-out="website._kt_get_organization_structured_data()"/>
        </xpath>
    </template>

    <!-- Keep crawlers off login/cart/account pages and the /website/social/*
         redirects (404 until a profile URL is set). AI crawlers (GPTBot,
         ClaudeBot, PerplexityBot...) fall under "*" and stay allowed. -->
    <template id="kt_robots" inherit_id="website.robots" name="Seriani robots.txt">
        <xpath expr="//t[@t-foreach='allowed_routes']" position="after">
Disallow: /web/login
Disallow: /web/signup
Disallow: /web/reset_password
Disallow: /my
Disallow: /shop
Disallow: /website/social/
</xpath>
    </template>
</odoo>
