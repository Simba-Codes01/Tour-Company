<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- website_sale ships a minimal site-wide Organization JSON-LD block
         (name/logo/url only) in every page's head. Enrich it into a proper
         TravelAgency listing - address, phone, email, the social profiles
         already set on the website, and an explicit areaServed so search
         engines understand Seriani serves travelers across East Africa,
         not just Kenya searches. -->
    <template id="kt_organization_structured_data" inherit_id="website_sale.website_sale_layout" name="Seriani Structured Data (Organization)">
        <xpath expr="//script[@t-if='res_company and website']" position="replace">
            <script t-if="res_company and website" type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "TravelAgency",
    "name": "<t t-out="res_company.name"/>",
    "logo": "<t t-out="'%s/logo.png?company=%s' % (base_url, res_company.id)"/>",
    "url": "<t t-out="base_url"/>",
    "telephone": "<t t-out="res_company.phone or ''"/>",
    "email": "<t t-out="res_company.email or ''"/>",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "Nairobi",
        "addressCountry": "KE"
    },
    "areaServed": [
        {"@type": "Country", "name": "Kenya"},
        {"@type": "Country", "name": "Uganda"},
        {"@type": "Country", "name": "Tanzania"},
        {"@type": "Country", "name": "Rwanda"},
        {"@type": "Country", "name": "Burundi"},
        {"@type": "Country", "name": "South Sudan"}
    ],
    "sameAs": [
        <t t-if="website.social_facebook">"<t t-out="website.social_facebook"/>"<t t-if="website.social_instagram or website.social_twitter">,</t></t>
        <t t-if="website.social_instagram">"<t t-out="website.social_instagram"/>"<t t-if="website.social_twitter">,</t></t>
        <t t-if="website.social_twitter">"<t t-out="website.social_twitter"/>"</t>
    ]
}
            </script>
        </xpath>
    </template>
</odoo>
